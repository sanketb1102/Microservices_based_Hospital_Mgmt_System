# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is in .gitignore and must never be committed.

# ---- Database --------------------------------------------------------
# All five services connect to the same MongoDB Atlas database (hms).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hms

# ---- JWT -------------------------------------------------------------
# Shared by every service: auth signs tokens with it, the others verify.
# Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1h

# ---- Email (OTP and invite delivery) --------------------------------
# Leave both blank in development and the OTP is printed to the
# auth-service logs instead of being emailed.
# For Gmail use an App Password, not your account password.
SMTP_USER=
SMTP_PASS=

# Used to build the invite link that is emailed out.
FRONTEND_URL=http://localhost
